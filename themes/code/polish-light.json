  "tokenColors": [
    {
      "name": "plain",
      "scope": [
        "source",
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#1E1E1E"
      }
    },
    {
      "name": "classes",
      "scope": [
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#9A5B00"
      }
    },
    {
      "name": "interfaces",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#9A5B00"
      }
    },
    {
      "name": "structs",
      "scope": [
        "entity.name.type.struct"
      ],
      "settings": {
        "foreground": "#9A5B00"
      }
    },
    {
      "name": "enums",
      "scope": [
        "entity.name.type.enum"
      ],
      "settings": {
        "foreground": "#9A5B00"
      }
    },
    {
      "name": "keys",
      "scope": [
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#9A5B00"
      }
    },
    {
      "name": "methods",
      "scope": [
        "entity.name.function.method",
        "meta.function.method"
      ],
      "settings": {
        "foreground": "#0B7A14"
      }
    },
    {
      "name": "functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#9A5B00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "variables",
      "scope": [
        "variable",
        "meta.variable",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#1E1E1E"
      }
    },
    {
      "name": "variablesOther",
      "scope": [
        "variable.other.object",
        "variable.other.readwrite.alias"
      ],
      "settings": {
        "foreground": "#0B7A14"
      }
    },
    {
      "name": "globalVariables",
      "scope": [
        "variable.other.global",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#6A3FC4"
      }
    },
    {
      "name": "localVariables",
      "scope": [
        "variable.other.local"
      ],
      "settings": {
        "foreground": "#E8E8EB"
      }
    },
    {
      "name": "parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#1E1E1E"
      }
    },
    {
      "name": "properties",
      "scope": [
        "variable.other.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#3B5DE8"
      }
    },
    {
      "name": "strings",
      "scope": [
        "string",
        "string.other.link",
        "markup.inline.raw.string.markdown"
      ],
      "settings": {
        "foreground": "#1F5F8B"
      }
    },
    {
      "name": "stringEscapeSequences",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#1E1E1E"
      }
    },
    {
      "name": "keywords",
      "scope": [
        "keyword"
      ],
      "settings": {
        "foreground": "#0B7A14"
      }
    },
    {
      "name": "keywordsControl",
      "scope": [
        "keyword.control.import",
        "keyword.control.from",
        "keyword.import"
      ],
      "settings": {
        "foreground": "#B4235A"
      }
    },
    {
      "name": "storageModifiers",
      "scope": [
        "storage.modifier",
        "keyword.modifier",
        "storage.type"
      ],
      "settings": {
        "foreground": "#3B5DE8"
      }
    },
    {
      "name": "comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7A7A80"
      }
    },
    {
      "name": "docComments",
      "scope": [
        "comment.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#A8A8AE"
      }
    },
    {
      "name": "numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#6A3FC4"
      }
    },
    {
      "name": "booleans",
      "scope": [
        "constant.language.boolean",
        "constant.language.json"
      ],
      "settings": {
        "foreground": "#9A5B00"
      }
    },
    {
      "name": "operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#B4235A"
      }
    },
    {
      "name": "macros",
      "scope": [
        "entity.name.function.preprocessor",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#3B5DE8"
      }
    },
    {
      "name": "preprocessor",
      "scope": [
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#6A3FC4"
      }
    },
    {
      "name": "urls",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#3B5DE8"
      }
    },
    {
      "name": "tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#3B5DE8"
      }
    },
    {
      "name": "jsxTags",
      "scope": [
        "support.class.component"
      ],
      "settings": {
        "foreground": "#6A3FC4"
      }
    },
    {
      "name": "attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#9A5B00"
      }
    },
    {
      "name": "types",
      "scope": [
        "support.type"
      ],
      "settings": {
        "foreground": "#9A5B00"
      }
    },
    {
      "name": "constants",
      "scope": [
        "variable.other.constant",
        "variable.readonly"
      ],
      "settings": {
        "foreground": "#1E1E1E"
      }
    },
    {
      "name": "labels",
      "scope": [
        "entity.name.label",
        "punctuation.definition.label"
      ],
      "settings": {
        "foreground": "#6A3FC4"
      }
    },
    {
      "name": "namespaces",
      "scope": [
        "entity.name.namespace",
        "storage.modifier.namespace",
        "markup.bold.markdown"
      ],
      "settings": {
        "foreground": "#9A5B00"
      }
    },
    {
      "name": "modules",
      "scope": [
        "entity.name.module",
        "storage.modifier.module"
      ],
      "settings": {
        "foreground": "#B4235A"
      }
    },
    {
      "name": "typeParameters",
      "scope": [
        "variable.type.parameter",
        "variable.parameter.type"
      ],
      "settings": {
        "foreground": "#9A5B00"
      }
    },
    {
      "name": "exceptions",
      "scope": [
        "keyword.control.exception",
        "keyword.control.trycatch"
      ],
      "settings": {
        "foreground": "#6A3FC4"
      }
    },
    {
      "name": "decorators",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#9A5B00"
      }
    },
    {
      "name": "calls",
      "scope": [
        "variable.function"
      ],
      "settings": {
        "foreground": "#1E1E1E"
      }
    },
    {
      "name": "punctuation",
      "scope": [
        "punctuation",
        "punctuation.terminator",
        "punctuation.definition.tag",
        "punctuation.separator",
        "punctuation.definition.string",
        "punctuation.section.block"
      ],
      "settings": {
        "foreground": "#7A7A80"
      }
    },
    {
      "name": "yellow",
      "scope": [
        "storage.type.numeric.go",
        "storage.type.byte.go",
        "storage.type.boolean.go",
        "storage.type.string.go",
        "storage.type.uintptr.go",
        "storage.type.error.go",
        "storage.type.rune.go",
        "constant.language.go",
        "support.class.dart",
        "keyword.other.documentation",
        "storage.modifier.import.java",
        "punctuation.definition.list.begin.markdown",
        "punctuation.definition.quote.begin.markdown",
        "meta.separator.markdown",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#9A5B00"
      }
    },
    {
      "name": "green",
      "scope": [],
      "settings": {
        "foreground": "#0B7A14"
      }
    },
    {
      "name": "cyan",
      "scope": [
        "markup.italic.markdown",
        "support.type.python",
        "variable.legacy.builtin.python",
        "support.constant.property-value.css",
        "storage.modifier.attribute.swift"
      ],
      "settings": {
        "foreground": "#1F5F8B"
      }
    },
    {
      "name": "blue",
      "scope": [],
      "settings": {
        "foreground": "#3B5DE8"
      }
    },
    {
      "name": "purple",
      "scope": [
        "keyword.channel.go",
        "keyword.other.platform.os.swift"
      ],
      "settings": {
        "foreground": "#6A3FC4"
      }
    },
    {
      "name": "magenta",
      "scope": [
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#6A3FC4"
      }
    },
    {
      "name": "red",
      "scope": [],
      "settings": {
        "foreground": "#B4235A"
      }
    },
    {
      "name": "orange",
      "scope": [],
      "settings": {
        "foreground": "#9A5B00"
      }
    }
  ]
}
