  "tokenColors": [
    {
      "name": "plain",
      "scope": [
        "source",
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#E6E6E8"
      }
    },
    {
      "name": "classes",
      "scope": [
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#F1C070"
      }
    },
    {
      "name": "interfaces",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#F1C070"
      }
    },
    {
      "name": "structs",
      "scope": [
        "entity.name.type.struct"
      ],
      "settings": {
        "foreground": "#F1C070"
      }
    },
    {
      "name": "enums",
      "scope": [
        "entity.name.type.enum"
      ],
      "settings": {
        "foreground": "#F1C070"
      }
    },
    {
      "name": "keys",
      "scope": [
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#F1C070"
      }
    },
    {
      "name": "methods",
      "scope": [
        "entity.name.function.method",
        "meta.function.method"
      ],
      "settings": {
        "foreground": "#7ED98B"
      }
    },
    {
      "name": "functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#F1C070",
        "fontStyle": "bold"
      }
    },
    {
      "name": "variables",
      "scope": [
        "variable",
        "meta.variable",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#E6E6E8"
      }
    },
    {
      "name": "variablesOther",
      "scope": [
        "variable.other.object",
        "variable.other.readwrite.alias"
      ],
      "settings": {
        "foreground": "#7ED98B"
      }
    },
    {
      "name": "globalVariables",
      "scope": [
        "variable.other.global",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#C3A6FF"
      }
    },
    {
      "name": "localVariables",
      "scope": [
        "variable.other.local"
      ],
      "settings": {
        "foreground": "#222224"
      }
    },
    {
      "name": "parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#E6E6E8"
      }
    },
    {
      "name": "properties",
      "scope": [
        "variable.other.property",
        "meta.property"
      ],
      "settings": {
        "foreground": "#8AA4FF"
      }
    },
    {
      "name": "strings",
      "scope": [
        "string",
        "string.other.link",
        "markup.inline.raw.string.markdown"
      ],
      "settings": {
        "foreground": "#7CC4F5"
      }
    },
    {
      "name": "stringEscapeSequences",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#E6E6E8"
      }
    },
    {
      "name": "keywords",
      "scope": [
        "keyword"
      ],
      "settings": {
        "foreground": "#7ED98B"
      }
    },
    {
      "name": "keywordsControl",
      "scope": [
        "keyword.control.import",
        "keyword.control.from",
        "keyword.import"
      ],
      "settings": {
        "foreground": "#FF7AA2"
      }
    },
    {
      "name": "storageModifiers",
      "scope": [
        "storage.modifier",
        "keyword.modifier",
        "storage.type"
      ],
      "settings": {
        "foreground": "#8AA4FF"
      }
    },
    {
      "name": "comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7C7C82"
      }
    },
    {
      "name": "docComments",
      "scope": [
        "comment.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#5A5A5F"
      }
    },
    {
      "name": "numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#C3A6FF"
      }
    },
    {
      "name": "booleans",
      "scope": [
        "constant.language.boolean",
        "constant.language.json"
      ],
      "settings": {
        "foreground": "#F1C070"
      }
    },
    {
      "name": "operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#FF7AA2"
      }
    },
    {
      "name": "macros",
      "scope": [
        "entity.name.function.preprocessor",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#8AA4FF"
      }
    },
    {
      "name": "preprocessor",
      "scope": [
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#C3A6FF"
      }
    },
    {
      "name": "urls",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#8AA4FF"
      }
    },
    {
      "name": "tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#8AA4FF"
      }
    },
    {
      "name": "jsxTags",
      "scope": [
        "support.class.component"
      ],
      "settings": {
        "foreground": "#C3A6FF"
      }
    },
    {
      "name": "attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#F1C070"
      }
    },
    {
      "name": "types",
      "scope": [
        "support.type"
      ],
      "settings": {
        "foreground": "#F1C070"
      }
    },
    {
      "name": "constants",
      "scope": [
        "variable.other.constant",
        "variable.readonly"
      ],
      "settings": {
        "foreground": "#E6E6E8"
      }
    },
    {
      "name": "labels",
      "scope": [
        "entity.name.label",
        "punctuation.definition.label"
      ],
      "settings": {
        "foreground": "#C3A6FF"
      }
    },
    {
      "name": "namespaces",
      "scope": [
        "entity.name.namespace",
        "storage.modifier.namespace",
        "markup.bold.markdown"
      ],
      "settings": {
        "foreground": "#F1C070"
      }
    },
    {
      "name": "modules",
      "scope": [
        "entity.name.module",
        "storage.modifier.module"
      ],
      "settings": {
        "foreground": "#FF7AA2"
      }
    },
    {
      "name": "typeParameters",
      "scope": [
        "variable.type.parameter",
        "variable.parameter.type"
      ],
      "settings": {
        "foreground": "#F1C070"
      }
    },
    {
      "name": "exceptions",
      "scope": [
        "keyword.control.exception",
        "keyword.control.trycatch"
      ],
      "settings": {
        "foreground": "#C3A6FF"
      }
    },
    {
      "name": "decorators",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#F1C070"
      }
    },
    {
      "name": "calls",
      "scope": [
        "variable.function"
      ],
      "settings": {
        "foreground": "#E6E6E8"
      }
    },
    {
      "name": "punctuation",
      "scope": [
        "punctuation",
        "punctuation.terminator",
        "punctuation.definition.tag",
        "punctuation.separator",
        "punctuation.definition.string",
        "punctuation.section.block"
      ],
      "settings": {
        "foreground": "#7C7C82"
      }
    },
    {
      "name": "yellow",
      "scope": [
        "storage.type.numeric.go",
        "storage.type.byte.go",
        "storage.type.boolean.go",
        "storage.type.string.go",
        "storage.type.uintptr.go",
        "storage.type.error.go",
        "storage.type.rune.go",
        "constant.language.go",
        "support.class.dart",
        "keyword.other.documentation",
        "storage.modifier.import.java",
        "punctuation.definition.list.begin.markdown",
        "punctuation.definition.quote.begin.markdown",
        "meta.separator.markdown",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#F1C070"
      }
    },
    {
      "name": "green",
      "scope": [],
      "settings": {
        "foreground": "#7ED98B"
      }
    },
    {
      "name": "cyan",
      "scope": [
        "markup.italic.markdown",
        "support.type.python",
        "variable.legacy.builtin.python",
        "support.constant.property-value.css",
