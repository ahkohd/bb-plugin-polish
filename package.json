{
  "name": "bb-plugin-polish",
  "version": "0.6.0",
  "type": "module",
  "engines": {
    "bb": ">=0.49",
    "bbPluginSdk": ">=0.6.132"
  },
  "bb": {
    "name": "Polish [Experimental]",
    "description": "A clean, calm bb in the manner of Capy, T3 Code, Conductor and Amp. A theme with four palettes, backdrops and layout options, plus a sidebar inbox that never re-orders with Snoozed, Settled and Muted shelves, an Overview with a board and peek pane, a compact sidebar dock, a Crew roster, a needs-you pill, a status line, zen mode and keyboard commands.",
    "branding": {
      "icon": "Sparkles"
    },
    "server": "./server.ts",
    "skills": [],
    "themes": [
      {
        "id": "polish",
        "name": "Polish",
        "description": "Clean and minimal, in the style of Capy",
        "css": "./themes/polish.css",
        "codeTheme": {
          "light": "./themes/code/polish-light.json",
          "dark": "./themes/code/polish-dark.json"
        }
      }
    ],
    "app": "./app.tsx"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.132",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "vitest": "^4.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/react": "^16.3.2",
    "clsx": "^2.1.1",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0"
  },
  "description": "A clean, minimal bb in the style of Capy.",
  "scripts": {
    "build": "bb plugin build",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  }
}
